{
  "expo": {
    "name": "CrewUp",
    "slug": "crew-up-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios/AppIcon-1024.png",
    "scheme": "crewup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.banamedia.crewup",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.banamedia.crewup",
      "adaptiveIcon": {
        "backgroundColor": "#0E1113",
        "foregroundImage": "./assets/android/adaptive-icon/ic_launcher_foreground.png",
        "backgroundImage": "./assets/android/adaptive-icon/ic_launcher_background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-icon-ink.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F4",
          "imageWidth": 180
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db038f44-b6c1-47d4-857a-63c376fec720"
      }
    },
    "owner": "myeung-bana"
  }
}

{
  "expo": {
    "name": "CrewUp",
    "slug": "crew-up-app",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/ios/AppIcon-1024.png",
    "scheme": "crewup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.banamedia.crewup",
      "usesAppleSignIn": true,
      "icon": {
        "light": "./assets/ios/AppIcon-1024.png",
        "dark": "./assets/ios/AppIcon-1024.png",
        "tinted": "./assets/ios/AppIcon-1024-tinted-source.png"
      },
      "infoPlist": {
        "CFBundleDisplayName": "CrewUp",
        "CFBundleName": "CrewUp",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      },
      "associatedDomains": [
        "applinks:crewup.app"
      ]
    },
    "android": {
      "package": "com.the6ixtech.crewup",
      "adaptiveIcon": {
        "backgroundColor": "#0E1113",
        "foregroundImage": "./assets/android/adaptive-icon/ic_launcher_foreground.png",
        "backgroundImage": "./assets/android/adaptive-icon/ic_launcher_background.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "crewup.app",
              "pathPrefix": "/c/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-wordmark-lime.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E1113",
          "imageWidth": 210,
          "android": {
            "imageWidth": 180
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#A8E05F"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CrewUp uses your photos so you can choose a profile picture or import a screenshot of your roster.",
          "cameraPermission": "CrewUp uses the camera to take a profile picture and to scan Crew QR codes. Nothing is recorded or saved without you.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CrewUp uses the camera to take a profile picture and to scan Crew QR codes. Nothing is recorded or saved without you.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CrewUp uses your location to suggest venues near you and show how far they are. It's only used while you pick a venue.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "legal": {
        "privacyUrl": "https://6ixtech.xyz/privacy",
        "termsUrl": "https://6ixtech.xyz/terms",
        "supportEmail": "support@6ixtech.xyz",
        "deletionUrl": "https://crewup.app/delete-account"
      },
      "router": {},
      "eas": {
        "projectId": "db038f44-b6c1-47d4-857a-63c376fec720"
      }
    },
    "owner": "the-6ixtech-studios"
  }
}

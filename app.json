{
  "expo": {
    "name": "CrewUp",
    "slug": "crew-up-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios/AppIcon-1024.png",
    "scheme": "crewup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.banamedia.crewup",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.banamedia.crewup",
      "adaptiveIcon": {
        "backgroundColor": "#0E1113",
        "foregroundImage": "./assets/android/adaptive-icon/ic_launcher_foreground.png",
        "backgroundImage": "./assets/android/adaptive-icon/ic_launcher_background.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logos/crewup-wordmark-lime-2400.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E1113",
          "imageWidth": 210
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "CrewUp uses your photos so you can choose a profile picture or import a screenshot of your roster.",
          "cameraPermission": "CrewUp uses the camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "legal": {
        "privacyUrl": "https://crewup.app/privacy",
        "termsUrl": "https://crewup.app/terms",
        "supportEmail": "support@crewup.app",
        "deletionUrl": "https://crewup.app/delete-account"
      },
      "router": {},
      "eas": {
        "projectId": "db038f44-b6c1-47d4-857a-63c376fec720"
      }
    },
    "owner": "myeung-bana"
  }
}

# CrewUp connects to crew-up-nhost (local or cloud).
EXPO_PUBLIC_NHOST_SUBDOMAIN=local
EXPO_PUBLIC_NHOST_REGION=local

# Optional explicit service URLs (override subdomain/region resolution):
# EXPO_PUBLIC_NHOST_AUTH_URL=https://local.auth.local.nhost.run/v1
# EXPO_PUBLIC_NHOST_GRAPHQL_URL=https://local.graphql.local.nhost.run/v1
# EXPO_PUBLIC_NHOST_STORAGE_URL=https://local.storage.local.nhost.run/v1
# EXPO_PUBLIC_NHOST_FUNCTIONS_URL=https://local.functions.local.nhost.run/v1

# Deep link scheme for password reset (must match app.json scheme)
EXPO_PUBLIC_APP_SCHEME=crewup

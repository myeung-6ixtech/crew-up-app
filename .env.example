# Nhost Cloud (use subdomain from Dashboard → Authentication → Google)
EXPO_PUBLIC_NHOST_SUBDOMAIN=tvxoufuvglucgbdftsns
EXPO_PUBLIC_NHOST_REGION=ap-southeast-1

# Local only (nhost up) — comment cloud vars above and use:
# EXPO_PUBLIC_NHOST_SUBDOMAIN=local
# EXPO_PUBLIC_NHOST_REGION=local

# Optional explicit service URL overrides:
# EXPO_PUBLIC_NHOST_AUTH_URL=https://tvxoufuvglucgbdftsns.auth.ap-southeast-1.nhost.run/v1
# EXPO_PUBLIC_NHOST_GRAPHQL_URL=https://crewup-dev.graphql.ap-southeast-1.nhost.run/v1
# EXPO_PUBLIC_NHOST_STORAGE_URL=https://crewup-dev.storage.ap-southeast-1.nhost.run/v1
# EXPO_PUBLIC_NHOST_FUNCTIONS_URL=https://crewup-dev.functions.ap-southeast-1.nhost.run/v1

# Deep link scheme (must match app.json scheme)
EXPO_PUBLIC_APP_SCHEME=crewup

# Push notifications (disabled for local dev — enable after `eas init`)
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
# EXPO_PUBLIC_EAS_PROJECT_ID=<uuid-from-eas-init>

# Do NOT put GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET here — configure in crew-up-nhost secrets only.
